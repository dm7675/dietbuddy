# Copy this file to .env.local and fill in the two values from your Supabase project
# (Dashboard ? Project Settings ? API). Both are public by design ? safe in the app.
# The Gemini key does NOT go here; it is a secret on the Supabase function.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
